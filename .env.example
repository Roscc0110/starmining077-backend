# Token del bot de Telegram (obtenido de @BotFather tras /newbot)
BOT_TOKEN=123456:ABC-DEF_pon_tu_token_aqui

# Puerto del servidor
PORT=3000

# URL pública donde se hospeda el backend (HTTPS). El frontend la usa como API.
# Si sirves el frontend desde este mismo servidor (carpeta public/), dejalo vacio.
PUBLIC_URL=https://tu-dominio.com

# Tarifas de retiro (GRAM) — no es obligatorio, se pueden ajustar
FEE_MIN_GRAM=0.001
FEE_MAX_GRAM=1
MAX_DELAY_DAYS=7
